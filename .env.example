# Copy to .env (which is git-ignored) and fill in. Never commit real values.

# Embrapa AgroAPI: create an account and an application in the AgroAPI store,
# subscribe to Agritec and ClimAPI, then copy the token and the base URLs.
AGROAPI_TOKEN=
AGROAPI_AGRITEC_URL=
AGROAPI_CLIMAPI_URL=

# WhatsApp Business Cloud API (Meta): only needed when notifier = "whatsapp".
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=pt_BR
WHATSAPP_API_VERSION=v21.0
